generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  DISPATCHER
  TECHNICIAN
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Organisation {
  id                String           @id @default(uuid()) @db.Uuid
  slug              String           @unique
  name              String
  storageQuotaBytes BigInt           @default(52428800) // Default 50 MB (50 * 1024 * 1024)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  users             User[]
  workOrders        WorkOrder[]
  events            WorkOrderEvent[]
  attachments       Attachment[]
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  organisationId      String           @db.Uuid
  organisation        Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  email               String           @unique
  name                String
  passwordHash        String
  role                UserRole
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  authVersion         Int              @default(0)
  sessions            Session[]
  createdWorkOrders   WorkOrder[]      @relation("WorkOrderCreator")
  assignedWorkOrders  WorkOrder[]      @relation("WorkOrderAssignedTechnician")
  workOrderEvents     WorkOrderEvent[]
  uploadedAttachments Attachment[]

  @@unique([organisationId, id])
  @@index([organisationId])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @db.Char(64)
  csrfToken   String
  authVersion Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model WorkOrder {
  id                   String            @id @default(uuid()) @db.Uuid
  organisationId       String            @db.Uuid
  organisation         Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reference            String
  title                String
  description          String
  priority             WorkOrderPriority @default(MEDIUM)
  status               WorkOrderStatus   @default(DRAFT)
  siteName             String
  creatorId            String            @db.Uuid
  creator              User              @relation("WorkOrderCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignedTechnicianId String?           @db.Uuid
  assignedTechnician   User?             @relation("WorkOrderAssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: Restrict)
  scheduledStart       DateTime?         @db.Timestamptz(3)
  scheduledEnd         DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  events               WorkOrderEvent[]
  attachments          Attachment[]

  @@unique([organisationId, id])
  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, assignedTechnicianId])
  @@index([organisationId, scheduledStart])
}

enum WorkOrderEventType {
  STATUS_CHANGED
  NOTE_ADDED
  WORK_STARTED
  WORK_COMPLETED
}

model WorkOrderEvent {
  id             String             @id @default(uuid()) @db.Uuid
  eventId        String
  organisationId String             @db.Uuid
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  workOrderId    String             @db.Uuid
  workOrder      WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           WorkOrderEventType
  occurredAt     DateTime           @db.Timestamptz(3)
  payload        Json               @db.JsonB
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([organisationId, eventId])
  @@index([organisationId, workOrderId, createdAt(sort: Desc)])
}

model Attachment {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @db.Uuid
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  workOrderId      String       @db.Uuid
  workOrder        WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  uploaderId       String       @db.Uuid
  uploader         User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  storageKey       String
  originalFileName String
  mimeType         String
  byteSize         Int
  contentHash      String       @db.Char(64)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([organisationId, workOrderId, contentHash])
  @@index([organisationId, workOrderId, createdAt(sort: Desc)])
  @@index([organisationId, contentHash])
  @@index([organisationId, createdAt])
}
