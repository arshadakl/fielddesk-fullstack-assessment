{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".prettierrc.json", ".prettierignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "NEXT_PUBLIC_*"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "NEXT_PUBLIC_*"]
    },
    "@fielddesk/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "DATABASE_URL", "REDIS_URL", "NODE_ENV"]
    },
    "@fielddesk/api#start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "DATABASE_URL", "REDIS_URL", "NODE_ENV"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "lint:fix": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": [] }
  }
}
