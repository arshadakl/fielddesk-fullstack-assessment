# Docker Compose reads the root .env for YAML substitution.
# Only POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB are passed to PostgreSQL.
# These are local development examples, not production credentials.
POSTGRES_USER=fielddesk
POSTGRES_PASSWORD=fielddesk_local_password
POSTGRES_DB=fielddesk
POSTGRES_PORT=5432
REDIS_PORT=6379
